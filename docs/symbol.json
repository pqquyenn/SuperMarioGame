{
  "description": "Mapping of ASCII characters/tokens to static tile blocks in TileMap.cpp",
  "symbols": {
    "X": "GroundBlock (Overworld)",
    "B": "HardBlock (Stairs, Pyramids, Flagpole base)",
    "S": "Brick (Destructible)",
    "<": "PipeTop (Left side)",
    ">": "PipeTop (Right side)",
    "[": "PipeBottom (Left side)",
    "]": "PipeBottom (Right side)",
    "1": "PipeConnection (Part 1)",
    "2": "PipeConnection (Part 2)",
    "3": "PipeConnection (Part 3)",
    "4": "PipeConnection (Part 4)",
    "5": "PipeConnection (Part 5)",
    "6": "PipeConnection (Part 6)",
    "7": "PipeConnection (Part 7)",
    "C": "Castle (80x80 large tile)",
    "LC": "LargeCastle (148x176 large tile)",
    "P": "FlagPole (Top knob)",
    "|": "FlagPole (Middle pole)",
    "F": "Flag",
    "u": "UndergroundBlock (Solid floor for 1-2)",
    "r": "UndergroundBrick (Blue bricks for 1-2)",
    "*": "BlackTile (Solid black background fill)",
    "W": "Warp Text Placeholder (uses Brick texture currently)",
    "uh": "UndergroundHardBlock",
    "pf1": "Platform (Left edge, 16x8)",
    "pf2": "Platform (Middle section, 16x8)",
    "pf3": "Platform (Right edge, 16x8)",
    "T": "Tree Trunk (Vertical brown wood from SpriteIsland)",
    "G": "Green Cap (Grass platform top from SpriteIsland)"
  },
  "scenery_groups": {
    "bu1..bu4": "Bush1 (Single Bush, 2x2 grid)",
    "Bu1..Bu6": "Bush2 (Double Bush, 3x2 grid)",
    "bU1..bU8": "Bush3 (Triple Bush, 4x2 grid)",
    "cl1..cl4": "Cloud1 (Single Cloud, 2x2 grid)",
    "Cl1..Cl6": "Cloud2 (Double Cloud, 3x2 grid)",
    "cL1..cL8": "Cloud3 (Triple Cloud, 4x2 grid)",
    "h1..h6": "Hill1 (Small Hill, 3x2 grid)",
    "H1..H15": "Hill2 (Big Hill, 5x3 grid)",
    "isl1..isl12": "SpriteIsland (Athletic platforms, 4x3 grid)"
  }
}
